<UserControl x:Class="WindowsMemo.Views.NoteView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="맑은 고딕" FontSize="13" Background="#FFF7C2">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Focusable" Value="False" />
   <Setter Property="Padding" Value="9,5" />
   <Setter Property="Margin" Value="2" />
   <Setter Property="Background" Value="#FFFFF3" />
   <Setter Property="BorderBrush" Value="#D4C67F" />
  </Style>
 </UserControl.Resources>
 <Border BorderBrush="#B7A868" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="40" /><RowDefinition Height="Auto" />
    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid Background="#F0DF91">
    <Thumb x:Name="MoveGrip" Cursor="SizeAll" DragDelta="MoveGrip_OnDragDelta">
     <Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent"><TextBlock Text="Windows 메모 · 시제품" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
     </ControlTemplate></Thumb.Template>
    </Thumb>
    <Button Content="닫기" HorizontalAlignment="Right" Click="Close_OnClick" ToolTip="시제품 종료" />
   </Grid>
   <WrapPanel Grid.Row="1" Margin="6">
    <Button Content="굵게" FontWeight="Bold" Click="Bold_OnClick" ToolTip="선택 영역 굵게 (Ctrl+B)" />
    <Button Content="검정" Click="Black_OnClick" />
    <Button Content="빨강" Foreground="#B42318" Click="Red_OnClick" />
    <Button Content="파랑" Foreground="#175CD3" Click="Blue_OnClick" />
    <Button Content="• 목록" Click="Bullets_OnClick" />
    <Button Content="1. 목록" Click="Numbering_OnClick" />
   </WrapPanel>
   <RichTextBox x:Name="Editor" Grid.Row="2" Margin="10,0,10,8" Padding="8"
    Background="#FFFFF5" BorderThickness="0" VerticalScrollBarVisibility="Auto"
    FontSize="16" AcceptsTab="True" AllowDrop="False" UndoLimit="100"
    PreviewTextInput="Editor_OnPreviewTextInput" TextChanged="Editor_OnTextChanged">
    <FlowDocument PagePadding="0"><Paragraph /></FlowDocument>
   </RichTextBox>
   <Grid Grid.Row="3" Margin="10,0,6,6">
    <StackPanel Margin="0,0,20,0">
     <TextBlock Text="저장하지 않는 기술 검증 시제품" Foreground="#8A3B12" />
     <TextBlock x:Name="ModeLabel" FontSize="11" Foreground="#5E5A45" TextWrapping="Wrap" />
     <TextBlock x:Name="NoticeLabel" FontSize="11" Foreground="#8A3B12" TextWrapping="Wrap" />
    </StackPanel>
    <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
     Cursor="SizeNWSE" DragDelta="ResizeGrip_OnDragDelta">
     <Thumb.Template><ControlTemplate TargetType="Thumb">
      <TextBlock Text="◢" Foreground="#8E8050" FontSize="18" />
     </ControlTemplate></Thumb.Template>
    </Thumb>
   </Grid>
  </Grid>
 </Border>
</UserControl>
