<UserControl x:Class="WindowsMemo.Views.NoteView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WindowsMemo.Views"
 FontFamily="{x:Static local:NoteTheme.Font}" FontSize="{x:Static local:NoteTheme.BodySize}"
 Foreground="{x:Static local:NoteTheme.Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="Tool" TargetType="Button">
   <Setter Property="Width" Value="{x:Static local:NoteTheme.ToolSize}"/>
   <Setter Property="Height" Value="{x:Static local:NoteTheme.ToolSize}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#16000000"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Background" Value="#20000000"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="Opacity" Value="0"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Background="#18000000" CornerRadius="{x:Static local:NoteTheme.CornerRadius}" Margin="0,0,1,1">
  <Border x:Name="PaperBorder" Background="{x:Static local:NoteTheme.Butter}"
   CornerRadius="{x:Static local:NoteTheme.CornerRadius}" Margin="0,0,1,2" BorderBrush="#12000000" BorderThickness="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#10000000" CornerRadius="4,4,0,0"/>
    <Grid Grid.Row="1" Margin="10,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource Tool}" Content="+" ToolTip="새 메모" AutomationProperties.Name="새 메모" Click="New_OnClick"/>
     <Thumb x:Name="MoveGrip" Grid.Column="1" Cursor="SizeAll" DragDelta="MoveGrip_OnDragDelta" PreviewMouseLeftButtonDown="Header_OnMouseDown">
      <Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border Background="Transparent" Padding="8,0">
        <Grid>
         <TextBlock Text="{Binding NoteTitle, RelativeSource={RelativeSource AncestorType=local:NoteView}}" FontSize="{x:Static local:NoteTheme.TitleSize}" Foreground="{x:Static local:NoteTheme.Ink}"
          FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
         <TextBlock Text="⠿" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{x:Static local:NoteTheme.MutedInk}" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
           </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
       </Border>
      </ControlTemplate></Thumb.Template>
     </Thumb>
     <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource Tool}" Content="⋯" ToolTip="더보기 (Alt+M)" AutomationProperties.Name="더보기" Click="More_OnClick"/>
    </Grid>
    <Grid x:Name="Body" Grid.Row="2" Margin="{x:Static local:NoteTheme.ContentPadding}">
     <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="0"
      VerticalScrollBarVisibility="Auto" AcceptsTab="True" AllowDrop="False" UndoLimit="100"
      FontSize="{x:Static local:NoteTheme.BodySize}" Foreground="{x:Static local:NoteTheme.Ink}"
      AutomationProperties.Name="메모 내용" PreviewKeyDown="Editor_OnPreviewKeyDown" PreviewMouseLeftButtonDown="Editor_OnMouseDown"
      PreviewTextInput="Editor_OnPreviewTextInput" TextChanged="Editor_OnTextChanged">
      <FlowDocument PagePadding="0"><Paragraph Margin="0,0,0,8"/></FlowDocument>
     </RichTextBox>
     <TextBlock x:Name="Placeholder" Text="생각을 적어보세요…" Foreground="#887D62" IsHitTestVisible="False" Margin="0,2,0,0"/>
    </Grid>
    <Grid x:Name="Footer" Grid.Row="3" Margin="22,0,12,10">
     <StackPanel Margin="0,0,20,0">
      <TextBlock x:Name="SaveLabel" Foreground="#9D3327" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="SaveButton" Content="저장 다시 시도" MinHeight="28" Visibility="Collapsed" HorizontalAlignment="Left" Click="Save_OnClick"/>
      <TextBlock x:Name="ModeLabel" FontSize="11" Foreground="{x:Static local:NoteTheme.MutedInk}" TextWrapping="Wrap" Visibility="Collapsed"/>
      <Button x:Name="ReconnectButton" Content="바탕화면 다시 연결" MinHeight="28" Visibility="Collapsed" HorizontalAlignment="Left" Click="Reconnect_OnClick"/>
      <TextBlock x:Name="NoticeLabel" FontSize="11" Foreground="#9D3327" TextWrapping="Wrap"/>
     </StackPanel>
     <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeGrip_OnDragDelta">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Path Data="M 5,15 L 15,5 M 10,15 L 15,10" Stroke="#706D58" StrokeThickness="1" Opacity="0.45"/></ControlTemplate></Thumb.Template>
     </Thumb>
    </Grid>
   </Grid>
  </Border>
 </Border>
</UserControl>
